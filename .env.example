# ============================================================
# KI-Disposition Environment Variables
# ============================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ============================================================
# DATABASE
# ============================================================
DB_USER=kidb
DB_PASSWORD=ki_pass_dev
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ki_disposition

# ============================================================
# EXTERNAL SERVICES
# ============================================================
OSRM_URL=http://osrm:5000
OSRM_TIMEOUT=10000

# Google Maps API (optional - for alternative routing)
# GOOGLE_MAPS_API_KEY=your_api_key

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:3001
REACT_APP_API_URL=http://localhost:3000

# ============================================================
# REDIS (optional, for caching)
# ============================================================
REDIS_URL=redis://redis:6379
REDIS_DB=0

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info

# ============================================================
# FEATURES (toggle experimental features)
# ============================================================
FEATURE_OPPORTUNITY_MATCHING=true
FEATURE_PREDICTIVE_FAILURE=false
FEATURE_ML_OPTIMIZATION=false

# ============================================================
# PERFORMANCE TUNING
# ============================================================
MAX_CONCURRENT_OPTIMIZATIONS=5
OPTIMIZATION_TIMEOUT_SECONDS=30
VRP_TIME_LIMIT_SECONDS=20

# ============================================================
# SECURITY (for production)
# ============================================================
JWT_SECRET=change_me_in_production
ADMIN_API_KEY=change_me_in_production
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ============================================================
# EMAIL (for alerts)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password
ALERT_EMAIL_FROM=noreply@ki-disposition.de
ALERT_EMAIL_TO=admin@ki-disposition.de
